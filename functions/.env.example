# Cloud Function secrets and configuration.
# Copy this file to .env for local emulator development, or configure
# these values via `firebase functions:secrets:set` in production.

# Firebase Admin SDK is initialized automatically in Cloud Functions.
# No manual credentials needed.

# Stripe (required if payment.provider is 'stripe')
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MercadoPago (required if payment.provider is 'mercadopago')
MERCADOPAGO_ACCESS_TOKEN=TEST-...
MERCADOPAGO_WEBHOOK_SECRET=...

# MercadoPago notification URL and store return URLs.
# Set this to the deployed Cloud Function URL + /mercadoPagoWebhook
MERCADOPAGO_WEBHOOK_URL=https://your-region-your-project.cloudfunctions.net/mercadoPagoWebhook
STORE_URL=https://your-domain.web.app
