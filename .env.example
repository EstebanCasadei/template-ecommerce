# Copy this file to .env and fill in the client's Firebase project settings.
# Leave the values empty to keep using local mock data instead of Firestore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: connect the frontend to the local Firebase Functions emulator.
# Example: VITE_FUNCTIONS_EMULATOR=127.0.0.1:5001
VITE_FUNCTIONS_EMULATOR=
